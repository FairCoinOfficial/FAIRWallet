<?xml version="1.0" encoding="utf-8"?>
<!--
  The two widget providers.

  This manifest belongs to the MODULE and is merged into the app's at build
  time, which is why the widgets need no entry in `app.json` and no config
  plugin: `android/` is gitignored and regenerated by `expo prebuild`
  (`package.json`'s `build:android` runs it), so a hand-edited app manifest
  would be destroyed by the next build. The module is autolinked from
  `modules/` like any local Expo module.

  `android.appwidget.action.APPWIDGET_UPDATE` is the broadcast the system sends
  a provider, and `android:exported="true"` is required for the system to
  deliver it. Neither receiver acts on anything an untrusted sender could put in
  the intent — Glance re-composes from the local store — so an exported receiver
  here grants nothing.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <receiver
        android:name=".balance.BalanceWidgetReceiver"
        android:label="@string/fairwallet_balance_widget_label"
        android:exported="true">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/fairwallet_balance_widget_info" />
    </receiver>

    <receiver
        android:name=".actions.ActionsWidgetReceiver"
        android:label="@string/fairwallet_actions_widget_label"
        android:exported="true">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/fairwallet_actions_widget_info" />
    </receiver>
  </application>
</manifest>
